# Copy this file to .env and add your own credentials.
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voice-agent-demo

# Optional HTTP Basic Auth for the web app. Leave unset to disable locally.
VOICE_AGENT_USERNAME=
VOICE_AGENT_PASSWORD=

# Optional model overrides; these match the defaults in voice_notion_agent/config.py.
CHAT_MODEL=gemini-3.1-flash-lite
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=gemini-3.8-flash-tts
